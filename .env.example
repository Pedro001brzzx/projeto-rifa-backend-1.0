# ====================================================
# Variáveis de Ambiente — Railway (Produção)
# ====================================================
# Configure estas variáveis no painel do Railway:
# Project → Service → Variables

# Ambiente
FLASK_ENV=production

# Banco de Dados (gerado automaticamente pelo Railway PostgreSQL plugin)
# O Railway preenche DATABASE_URL automaticamente ao adicionar o plugin PostgreSQL.
# Não precisa configurar manualmente.
# DATABASE_URL=postgresql://usuario:senha@host:5432/railway

# Chaves Secretas (GERE CHAVES NOVAS E ÚNICAS PARA PRODUÇÃO!)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SEGURA_DE_64_CHARS
JWT_SECRET_KEY=SUBSTITUA_POR_OUTRA_CHAVE_SEGURA_DE_64_CHARS

# CORS — origens do seu frontend (separadas por vírgula, sem espaços)
# Exemplo: https://meusite.vercel.app,https://www.meudominio.com.br
CORS_ORIGINS=https://SEU_FRONTEND.vercel.app

# URL base do backend (usado nos webhooks do gateway de pagamento)
BASE_URL=https://SEU_BACKEND.up.railway.app

# Gateway de Pagamento AbacatePay
ABACATEPAY_API_KEY=abc_prod_SUA_CHAVE_AQUI
ABACATEPAY_WEBHOOK_SECRET=SEU_WEBHOOK_SECRET_AQUI

# Rota admin ofuscada (opcional — mude do padrão!)
ADMIN_ROUTE_SECRET=/api/painel-secreto-x9
