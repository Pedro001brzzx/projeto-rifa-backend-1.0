# Exemplo de arquivo .env
# Copie este arquivo para .env e configure suas variáveis

# Ambiente: development ou production
FLASK_ENV=development

# Banco de Dados
# Para desenvolvimento local (SQLite):
# DATABASE_URL=sqlite:///gemeos_brasil.db

# Para produção (PostgreSQL):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/gemeos_brasil

# Chaves secretas (gere novas chaves para produção!)
# SECRET_KEY=sua-chave-secreta-muito-segura-aqui
# JWT_SECRET_KEY=sua-chave-jwt-muito-segura-aqui

# Flask
# FLASK_APP=app.py
# FLASK_DEBUG=1
